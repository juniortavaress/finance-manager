# --- Banco de dados ---
# Usamos o driver psycopg (v3), por isso o prefixo é "postgresql+psycopg://"
#
# Local (Postgres instalado na maquina ou docker):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cofre
#
# Supabase (producao) - pegue em Project Settings > Database > Connection string (URI, modo "Transaction" na porta 6543
# para uso com pool, ou 5432 direto). Lembre de trocar [YOUR-PASSWORD] e adicionar o prefixo +psycopg.
# DATABASE_URL=postgresql+psycopg://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cofre

# --- Auth ---
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-grande
JWT_EXPIRES_MINUTES=10080

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# --- CORS ---
# URL(s) do frontend autorizadas a chamar a API, separadas por virgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
